# Copie este arquivo para ".env" e preencha com seus valores reais.
# O .env nunca deve ser commitado no git.

SECRET_KEY=troque-por-uma-chave-secreta-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Em desenvolvimento, deixe a linha abaixo comentada (ou apagada) para usar
# SQLite local automaticamente. Em produção, descomente e use a connection
# string do Supabase/Neon (Postgres).
# DATABASE_URL=postgres://usuario:senha@host:porta/nome_do_banco
